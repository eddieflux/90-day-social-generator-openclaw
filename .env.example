# 90-day social calendar pipeline - environment template
#
# The ONLY env var this package requires is the HighLevel API key,
# and it is only needed in Mode A (--email, HL-connected fetch).
# Mode B (--details / --client-json) needs NO env vars at all.
#
# Copy this file to .env and fill in what you use. Optional keys
# can also be passed as CLI flags instead (see run.sh).

# Required ONLY for Mode A (fetch client details from your HighLevel subaccount):
HIGHLEVEL_ACCESS_TOKEN=

# Optional: your HighLevel location id (auto-detected if the token
# has access to exactly one location):
# HIGHLEVEL_LOCATION_ID=

# Optional LLM key for post generation (or pass --llm-key to run.sh):
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Optional image provider keys (or pass flags to run.sh):
# GEMINI_API_KEY=
# FAL_KEY=
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
